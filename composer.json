{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "caiquerechi/crow-vault-canvas",
    "description": "A Laravel and React knowledge canvas package for Rechi OS.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.3.1",
        "laravel/framework": "^13.34.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.3.0"
    },
    "autoload": {
        "psr-4": {
            "CrowVaultCanvas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CrowVaultCanvas\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "CrowVaultCanvas\\CrowVaultCanvasServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
